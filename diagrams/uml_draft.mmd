classDiagram
    %% PawPal+ system design.
    %% Relationships are composition/association ("has-a"), not inheritance.

    class Owner {
        +str id
        +str name
        +dict availability
        +list~Pet~ pets
        +dict preferences
        +setAvailability(days, times) void
        +addPet(pet) void
        +removePet(petId) void
        +updatePreferences(prefs) void
        +getDailyPlan(date) list~Task~
    }

    class Pet {
        +str id
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +addTask(task) void
        +removeTask(taskId) void
        +getPendingTasks() list~Task~
        +updateInfo(info) void
    }

    class Task {
        +str id
        +str petId
        +str type
        +str scheduledTime
        +int durationMinutes
        +bool completed
        +int priority
        +schedule(time) void
        +reschedule(newTime) void
        +markCompleted() void
        +setPriority(p) void
    }

    class Schedule {
        +list~str~ daysOfWeek
        +list~str~ timeslots
        +dict slots
        +addTask(task, time) void
        +removeTask(taskId) void
        +editTask(taskId, newTime) void
        +findAvailableSlot(duration, prefs) str
        +generateDailyPlan(owner, date) list~Task~
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Owner "1" --> "1" Schedule : uses
    Schedule ..> Task : arranges
    Schedule ..> Owner : reads availability

